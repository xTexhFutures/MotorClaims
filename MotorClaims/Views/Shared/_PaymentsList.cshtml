@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Http.Features
@using System.Globalization

@inject IViewLocalizer _localizer
@using CORE.DTOs.MotorClaim.Claims;
@using CORE.DTOs.MotorClaim.WorkFlow;
@{
    Layout = null;
}

<div class="basic-detail">
    <div class="policy-header">
        <div class="name-number-wrapper">
            <div class="policy-name-wrapper">
                <img src="/assets/icons/empty-file.svg" class="policy-icon" />
                <p class="policy-name">
                    @_localizer["PaymentsHistory"].Value

                </p>
            </div>

        </div>

    </div>
    <div class="policy-detail-body undefined">
        <div class="inner-clild-wrap">

            <ul class="detail-list">

                <li class="detailed-item false">
                    <span class="detailed-icon-wrap">
                        <img src="/assets/icons/save.svg" alt="" class="item-icon">
                    </span>
                    <div class="item-content">
                        <span class="label tran">
                            @_localizer["ClaimantName"].Value

                        </span>
                    </div>
                </li>
                <li class="detailed-item false">
                    <span class="detailed-icon-wrap">
                        <img src="/assets/icons/save.svg" alt="" class="item-icon">
                    </span>
                    <div class="item-content">
                        <span class="label" >
                            @_localizer["NetSettlement"].Value

                        </span>
                    </div>
                </li>
                <li class="detailed-item false">
                    <span class="detailed-icon-wrap">
                        <img src="/assets/icons/calendar.svg" alt="" class="item-icon">
                    </span>
                    <div class="item-content">
                        <span class="label">
                            @_localizer["Iban"].Value

                        </span>
                    </div>
                </li>
                <li class="detailed-item false">
                    <span class="detailed-icon-wrap">
                        <img src="/assets/icons/save.svg" alt="" class="item-icon">
                    </span>
                    <div class="item-content">
                        <span class="label">
                            @_localizer["Creationdate"].Value

                        </span>
                    </div>
                </li>

                 <li class="detailed-item false">
                    <span class="detailed-icon-wrap">
                        <img src="/assets/icons/save.svg" alt="" class="item-icon">
                    </span>
                    <div class="item-content">
                        <span class="label">
                            @_localizer["SettlementType"].Value

                        </span>
                    </div>
                </li>

                <li class="detailed-item false">
                    <span class="detailed-icon-wrap">
                        <img src="/assets/icons/save.svg" alt="" class="item-icon">
                    </span>
                    <div class="item-content">
                        <span class="label">
                            @_localizer["Status"].Value

                        </span>
                    </div>
                </li>        
                <li class="detailed-item false">
                    <span class="detailed-icon-wrap">
                        <img src="/assets/icons/save.svg" alt="" class="item-icon">
                    </span>
                    <div class="item-content">
                        <span class="label">
                            @_localizer["TransferReference"].Value

                        </span>
                    </div>
                </li>
            </ul>
            @foreach (var clm in Model)
            {

                <ul class="detail-list">

                    <li class="detailed-item false">
                        <div class="item-content">
                            <h3 class="value ellipsis">@clm.ClaimantName</h3>
                        </div>
                    </li>
                         <li class="detailed-item false">
                        <div class="item-content">
                            <h3 class="value ellipsis">@clm.NetSettlement</h3>
                        </div>
                    </li>    
                    <li class="detailed-item false">
                        <div class="item-content">
                            <h3 class="value ellipsis">@clm.Iban</h3>
                        </div>
                    </li>

                    <li class="detailed-item false">

                        <div class="item-content">
                            <h3 class="value ellipsis">@(Helpers.FormatLongDate(clm.Creationdate))</h3>
                        </div>
                    </li>
                    <li class="detailed-item false">

                        @{
                            var y = Enum.TryParse(clm.SettlementType.ToString(), out Enums.SettlementType parsedEnumValue);
                        }
                        <div class="item-content">
                            <h3 class="value ellipsis">@parsedEnumValue</h3>
                        </div>
                    </li>
                    <li class="detailed-item false">

                        @{
                            var y1 = Enum.TryParse(clm.Status.ToString(), out Enums.Status parsedEnumValue1);
                        }
                        <div class="item-content">
                            <h3 class="value ellipsis">@parsedEnumValue1</h3>
                        </div>
                    </li>
                    <li class="detailed-item false">

                        <div class="item-content">
                            <h3 class="value ellipsis">@clm.TransferReference</h3>
                        </div>
                    </li>
                </ul>
            }

        </div>

    </div>
</div>


