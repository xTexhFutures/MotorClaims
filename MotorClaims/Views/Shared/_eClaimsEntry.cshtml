@using CORE.DTOs.MotorClaim.Claims;
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization;
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Http.Features
@using System.Globalization

@inject IViewLocalizer _localizer
@model CORE.DTOs.MotorClaim.eClaims

@{
    string policyNumber = (string)ViewData["policyNumber"];
    int? Serial = (int?)ViewData["Serial"];
    Serial = Serial.HasValue ? Serial : 1;
}


<div class="policy-detail-wrapper" >
    <form method="post" asp-controller="Operations" >
 <input type="hidden" name="Id" value="@Model.Id"/>
 <input type="hidden" name="MobileNo" value="@Model.MobileNo"/>
        <div class="policy-members">
            <div class="accordion-wrapper">


      
                <div class="accordion-item-wrapper active">
                    <div class="accordion-header" >
                        <div class="accordion-heaing-content">
                            <div class="heading-wrap">
                                <h2 class="heading">
                                    @_localizer["eClaims"].Value
                                    
                                </h2>
                            </div>

                        </div>
                    </div>
                    <div class="accordion-body active" id="Repair_1">
                          <ul class="dates-and-conpany-wrapper">

                            <li class="column-item">

                                <span class="value">@_localizer["ClaimType"].Value</span>
                                 <label for="InsuranceType1" class="radio-card-v2" style="min-width:24% !important">
                                    <input type="radio" value="1" name="InsuranceType" id="InsuranceType1"  @(Model.InsuranceType==1?"checked":"")/>
                                    <div class="card-content-wrapper">
                                        <span class="check-icon"></span>
                                        <div class="card-content">
                                            <h4 class="title">
                                                @_localizer["TPL"].Value
                                                
                                            </h4>
                                        </div>
                                    </div>
                                </label>
                                 <label for="InsuranceType2" class="radio-card-v2" style="min-width:24% !important">
                                    <input type="radio" value="2" name="InsuranceType" id="InsuranceType2"   @(Model.InsuranceType==2?"checked":"")/>
                                    <div class="card-content-wrapper">
                                        <span class="check-icon"></span>
                                        <div class="card-content">
                                            <h4 class="title">
                                                @_localizer["Comprehensive"].Value
                                                
                                            </h4>
                                        </div>
                                    </div>
                                </label>
                            </li>

                        </ul>
                        <ul class="dates-and-conpany-wrapper">

                            <li class="column-item">

                                <span class="value">@_localizer["AccidentSurveyedBy"].Value</span>
                                <label for="InsuranceSurveyed1" class="radio-card-v2" style="min-width:24% !important">
                                    <input type="radio" value="1" name="InsuranceSurveyed" id="InsuranceSurveyed1"  @(Model.InsuranceSurveyed==0?"checked":( Model.InsuranceSurveyed==1?"checked":""))/>
                                    <div class="card-content-wrapper">
                                        <span class="check-icon"></span>
                                        <div class="card-content">
                                            <h4 class="title">@_localizer["Najm"]</h4>
                                        </div>
                                    </div>
                                </label>
                                <label for="InsuranceSurveyed2" class="radio-card-v2" style="min-width:24% !important">
                                    <input type="radio" value="2" name="InsuranceSurveyed" id="InsuranceSurveyed2" @(Model.InsuranceSurveyed==2?"checked":"")/>
                                    <div class="card-content-wrapper">
                                        <span class="check-icon"></span>
                                        <div class="card-content">
                                            <h4 class="title">@_localizer["Basher"]</h4>
                                        </div>
                                    </div>
                                </label>
                                <label for="InsuranceSurveyed3" class="radio-card-v2" style="min-width:24% !important">
                                    <input type="radio" value="3" name="InsuranceSurveyed" id="InsuranceSurveyed3" @(Model.InsuranceSurveyed==3?"checked":"")/>
                                    <div class="card-content-wrapper">
                                        <span class="check-icon"></span>
                                        <div class="card-content">
                                            <h4 class="title">@_localizer["Other"]</h4>
                                        </div>
                                    </div>
                                </label>
                            </li>

                        </ul>
                        <ul class="dates-and-conpany-wrapper">

                            <li class="column-item">

                                <span class="value">@_localizer["RecoveryType"].Value</span>
                                <label for="RecoveryType1" class="radio-card-v2" style="min-width:24% !important">
                                    <input type="radio" value="1" name="RecoveryType" id="RecoveryType1" @(Model.RecoveryType==0?"checked":( Model.RecoveryType==1?"checked":""))/>
                                    <div class="card-content-wrapper">
                                        <span class="check-icon"></span>
                                        <div class="card-content">
                                            <h4 class="title">@_localizer["Repair"]</h4>
                                        </div>
                                    </div>
                                </label>
                                <label for="RecoveryType2" class="radio-card-v2" style="min-width:24% !important">
                                    <input type="radio" value="2" name="RecoveryType" id="RecoveryType2" @( Model.RecoveryType==2?"checked":"")/>
                                    <div class="card-content-wrapper">
                                        <span class="check-icon"></span>
                                        <div class="card-content">
                                            <h4 class="title">@_localizer["Transfer"]</h4>
                                        </div>
                                    </div>
                                </label>

                            </li>

                        </ul>
                        <ul class="dates-and-conpany-wrapper">
                            <li class="column-item">

                                <span class="value">
                                    @_localizer["AccidentReport"].Value
                                    
                                </span>
                                <div class="form-field-wrapper">
                                    <div class="form-input-wrapper">
                                        <input class="form-inputbox" required style="text-transform:uppercase" autocomplete="off" maxlength="15" id="txtAccidentReport" type="text" name="AccidentReport" value="@Model.AccidentReport" />
                                    </div>
                                </div>

                            </li>

                            <li class="column-item">

                                <span class="value">
                                    @_localizer["OwnerNationalID"].Value
                                    
                                </span>
                                <div class="form-field-wrapper">
                                    <div class="form-input-wrapper">
                                        <input class="form-inputbox" autocomplete="off" required maxlength="10" id="txtOwnerNationalID" type="text" placeholder="@_localizer["OwnerNationalID"]" name="OwnerNationalID" value="@Model.OwnerNationalID" />
                                    </div>
                                </div>

                            </li>
                            <li class="column-item">

                                <span class="value">
                                    @_localizer["SequenceNumber"].Value
                                    
                                </span>
                                <div class="form-field-wrapper">
                                    <div class="form-input-wrapper">
                                        <input class="form-inputbox" data-toggle="tooltip" autocomplete="off" required maxlength="30" id="txtSequenceNumber" type="text" placeholder="@_localizer["SequenceNumber"]" name="SequenceNumber" value="@Model.SequenceNumber" />
                                    </div>
                                </div>

                            </li>
                     
                        </ul>
               
                         <ul class="dates-and-conpany-wrapper">
   
                            <li class="column-item">

                                <span class="value">
                                    @_localizer["TaqdeerNumber"].Value
                                    
                                </span>
                                <div class="form-field-wrapper">
                                    <div class="form-input-wrapper">
                                        <input class="form-inputbox" autocomplete="off" style="text-transform:uppercase" maxlength="20" id="txtTaqdeerNumber" type="text" placeholder="@_localizer["TaqdeerNumber"]" name="TaqdeerNumber"  value="@Model.TaqdeerNumber"/>
                                    </div>
                                </div>

                            </li>
                            <li class="column-item">

                                <span class="value">
                                    @_localizer["LicenseExpiryDate"].Value
                                    
                                </span>
                                <div class="form-field-wrapper">
                                    <div class="form-input-wrapper">
                                        <input class="form-inputbox calendar-input" autocomplete="off" maxlength="15" id="txtLicenseExpiryDate" type="text" name="LicenseExpiryDate"  value="@Model.LicenseExpiryDate"/>
                                    </div>
                                </div>

                            </li>
                            <li class="column-item">

                                <span class="value">
                                    @_localizer["IBANNo"].Value
                                    
                                </span>
                                <div class="form-field-wrapper">
                                    <div class="form-input-wrapper">
                                     <input class="form-inputbox" autocomplete="off" maxlength="30" id="txtIBANNo" type="text" placeholder="@_localizer["IBANNo"]" name="IBANNo"  oninput="/^IT\d{2}[ ][a-zA-Z]\d{3}[ ]\d{4}[ ]\d{4}[ ]\d{4}[ ]\d{4}[ ]\d{3}|IT\d{2}[a-zA-Z]\d{22}$/" value="@Model.IBANNo"/>
  </div>
                                </div>

                            </li>
               
                        </ul>

                         <ul class="dates-and-conpany-wrapper">
   
                        
                            <li class="column-item">

                                <span class="value">
                                    @_localizer["Reference"].Value
                                    
                                </span>
                                <div class="form-field-wrapper">
                                    <div class="form-input-wrapper">
                                     <input class="form-inputbox" autocomplete="off" readonly id="txtReference" type="text" placeholder="@_localizer["Reference"]" name="Reference"   value="@Model.Reference"/>
  </div>
                                </div>

                            </li>
                              <li class="column-item">

                                <span class="value">
                                    @_localizer["RejectionReason"].Value
                                    
                                </span>
                                <div class="form-field-wrapper">
                                    <div class="form-input-wrapper">
                                        <textarea class="form-inputbox" autocomplete="off" maxlength="1024" name="RejectionReason">@Model.RejectionReason</textarea>
  </div>
                                </div>

                            </li>      
                            
                              <li class="column-item">

                                <span class="value">
                                    @_localizer["PolicyNumber"].Value
                                    
                                </span>
                                <div class="form-field-wrapper">
                                    <div class="form-input-wrapper">
                                    <input class="form-inputbox" autocomplete="off"  id="txtPolicyNumber" type="text" placeholder="@_localizer["PolicyNumber"]" name="PolicyNumber"   value="@policyNumber?.Trim()"/>

  </div>
                                </div>

                            </li> 
                            <li class="column-item">
                                  <span class="value">
                                    @_localizer["RejecteClaim"].Value
                                    
                                </span>
                                         <label for="RejecteClaim" class="switch">
                                                            <input id="RejecteClaim" name="IsRejected" type="checkbox" class="switch-check-box"  value="true">
                                                            <span class="slider round"></span>
                                          </label>

                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-actions-handle-Full">
            <div class="next-button">

                      <button asp-action="UpdateEclaimProccess" type="submit" class="button button-primary">
                        @_localizer["Update"].Value
                          
                </button> 
                
             

            </div>
        </div>
    </form>
</div>


@{
    List<Attachments> attachments=(List<Attachments>) ViewData["Attachments"];
    string DocumentsLink=(string)ViewData["DocumentsLink"];
    await Html.RenderPartialAsync("_eClaimDocuments", new { attachments = attachments, Link = DocumentsLink ,ClaimNo=string.Concat(Model.Reference,"/",Serial)});
}
<script>
      $('#txtOwnerNationalID').ForceIntegerEntry();
     $('#txtLicenseExpiryDate').ForceDateEntry();
</script>