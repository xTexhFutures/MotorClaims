@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Http.Features
@using System.Globalization

@inject IViewLocalizer _localizer
@using CORE.DTOs.MotorClaim.Claims;
@{
    Layout = null;
    int Serial = 0;
    int ClaimId = (int)ViewData["ClaimId"];
    int ClaimantId = (int)ViewData["ClaimantId"];
    ClaimMaster claim = (ClaimMaster)ViewData["ClaimMaster"];
}
@model List<ReserveDetails>
@if (claim.claims.PremiaClaimId.HasValue && claim.claims.PremiaClaimId.Value > 0)
{
    <div class="footer-actions-handle" style="position:inherit !important; width:100%">
        <div class="next-button" style="margin-right:5px">

            <button type="button" class="button button-primary" onclick="OperationReserve(@ClaimId,@ClaimantId)">
                @_localizer["AddNewReserve"].Value


            </button>


        </div>
    </div>
}
<div class="transaction-details">

        <table class="universal-table">
            <tr>
                <!-- <th>#</th> -->
            <th>
                @_localizer["ReserveSerial"].Value
                
            </th>         
            <th>
                @_localizer["PremiaCode"].Value
                
            </th>
            <th>
                @_localizer["TransactionAmount"].Value
                
            </th>
            <th>
                @_localizer["ReserveType"].Value
                
            </th>
            <th>
                @_localizer["IsSettled"].Value
                
            </th>
            <th>
                @_localizer["IsClosed"].Value
                
            </th>
              <th>
                @_localizer["Action"].Value
                
            </th>
            </tr>


            @foreach (var clm in Model)
            {

                 
                <tr>
                <td class="tran">@(++Serial)</td>
                <td>@clm.PremiaCode</td>
                <td>@clm.Amount</td>
                  @{
                        var y = Enum.TryParse(clm.ReserveType.ToString(), out MotorClaims.Models.Enums.ReserveType parsedEnumValue);
                    }
                <td>@parsedEnumValue</td>                
                <td>@clm.IsSettled</td>
                <td>@clm.IsClosed</td>
                  <td>
                      @if (claim.claims.PremiaClaimId.HasValue && claim.claims.PremiaClaimId.Value>0)
                    {
                             @if (!clm.IsClosed && clm.PremiaClaimId>0)
                    {
                          <a href="#" class="button button-primary" onclick="CloseReserve('@clm.Id','@clm.ReserveId')" style="line-height:1rem !important;margin:5px">
                @_localizer["Close"].Value
                
            </a>
                    }
              @if (clm.PremiaClaimId==0)
                    {
                          <a href="#" onclick="PushToPremia('@clm.Id','@clm.ReserveId')" class="button button-primary" style="line-height:1rem !important;margin:5px">
                @_localizer["Push To Premia"].Value
                
            </a>
                    }
                    }
      
 
                  </td>
                </tr>


            }
        </table>
    </div>
    <div class="common-slide-popup" id="UpdateReserve"></div>


                    <script>
                        function PushToPremia(Id,ReserveId){
                                spinner.show();
                             $('#ClaimantsReserve').load('/Claims/PushReserveToPremia/',{Id:Id,ReserveId:ReserveId},function(){
                                     spinner.hide();
                             });
                        }

                           function CloseReserve(Id,ReserveId){
                                spinner.show();
                             $('#ClaimantsReserve').load('/Claims/CloseReserve/',{Id:Id,ReserveId:ReserveId},function(){
                                     spinner.hide();
                             });
                        }
                    </script>