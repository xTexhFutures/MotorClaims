                                <li class="resent-list-item">
                                    @{
                                        ClaimSearchobj claimSearchobj = new ClaimSearchobj()
                                                                        {
                                                                            ClaimId = item.ClaimId
                                                                        };
                                    }
                                    <div class="request-card">
                                        <div class="request-card-header">
                                            <div class="timer-wrapper">
                                                <img src="/assets/icons/calendar.svg" class="timer-image" />
                                                <span class="timer case-no">@Helpers.FormatDate(item.CreationDate)</span>
                                                @{
                                                    var y = Enum.TryParse(item.Status.ToString(), out Enums.WorkflowStatus parsedEnumValue);
                                                }
                                            </div><span class="request-status orange">@parsedEnumValue</span>
                                        </div>
                                        <div class="request-body ">
                                            <div class="request-icon-wrapper">
                                                <img src="/assets/icons/users.svg" class="icon-request" />
                                            </div>
                                            <div class="request-details">
                                                <h3 class="request-person">Req: @item.ClaimNo</h3>
                                                <p class="request-person-type"></p>
                                            </div>
                                            <div class="request-btn-wrapper">
                                                <a href="@Url.Action("ClaimEntryFast","Claims",new{obj=MotorClaims.Models.Helpers.Encrypt(JsonConvert.SerializeObject(claimSearchobj))})" class="button button-primary">View</a>
                                            </div>
                                        </div>
                                        <div class="request-footer">
                                            <div class="request-category">
                                                <span class="category-icon">
                                                    <img src="/assets/icons/first-aid.svg" class="icon-heart" />
                                                </span>
                                                @{
                                                    var y1 = Enum.TryParse(item.WorkflowHeaderId.ToString(), out Enums.WorkflowType WorkflowEnumValue);
                                                }
                                                <span class="category-text">@WorkflowEnumValue</span>
                                            </div>
                                            <div class="request-no-wrap">
                                                <span class="request-icon">
                                                    <img class="file" src="/assets/icons/empty-file.svg" />
                                                </span>
                                                <span class="request-no">@item.ClaimantId</span>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <div class="ui-state-highlight ui-corner-all" style="background:none !important;margin-top: 1%;">
                                <span class="ui-icon ui-icon-info" style="float: left"></span>
                                <span>No results found.</span>
                            </div>
                        }
                     


                    </ul>
                </div>
            </div>
        </div>
        <div class="Toastify"></div>
    </div>
    <div class="right-sidebar false">
        <div class="inner-wrapper">
            <div class="resent-column">
              
     
            </div>
        </div>
    </div>
</div>


