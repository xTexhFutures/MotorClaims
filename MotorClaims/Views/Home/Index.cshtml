                                                </span>
                                                <span class="request-no">@item.ClaimantId</span>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <div class="ui-state-highlight ui-corner-all" style="background:none !important;margin-top: 1%;">
                                <span class="ui-icon ui-icon-info" style="float: left"></span>
                                <span>No results found.</span>
                            </div>
                        }
               
                     
                    </ul>
                </div>
                <div class="resent-column">
                    <div class="header-request-section">
                        <div class="heading-card">
                            <h2 class="heading">My Queue</h2>
                        </div>
                        <a class="view-link" href="/my-request.html">View All</a>
                    </div>
                    <ul class="resent-list-items">
                        @if (Queue.Count>0)
